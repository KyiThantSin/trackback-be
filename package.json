{
  "type": "module",
  "version": "1.0.0",
  "name": "trackback",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "prisma": "^8.0.0-rc.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "esbuild src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/app.js",
    "start": "node dist/app.js",
    "contract:emit": "prisma contract emit",
    "docker:dev": "docker compose up --build -d",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker build -t trackback . && docker run --rm -p 8080:8080 --env-file .env trackback"
  }
}
