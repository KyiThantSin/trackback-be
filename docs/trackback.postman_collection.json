    {
      "name": "notifications",
      "description": "Login as a user who has received a claim notification, then list notifications before marking one or all as read.",
      "item": [
        {
          "name": "list my notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/api/v1/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().items || [];",
                  "if (items.length > 0) {",
                  "    pm.collectionVariables.set('notificationId', items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "mark notification as read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{apiBase}}/api/v1/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "mark all notifications as read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{apiBase}}/api/v1/notifications/read-all"
          }
        }
      ]
    },
