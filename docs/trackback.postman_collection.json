    {
      "name": "lost-items",
      "description": "Public list/detail requests and authenticated create/recover requests for LostItemPost.",
      "item": [
        {
          "name": "list lost items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/lost-items?page=1&limit=10&status=OPEN"
          }
        },
        {
          "name": "get lost item by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/lost-items/{{lostItemId}}"
          }
        },
        {
          "name": "create lost item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Black wallet\",\n  \"description\": \"Black leather wallet found near the library.\",\n  \"category\": \"wallet\",\n  \"lastSeenLocation\": \"Central Library\",\n  \"lastSeenDate\": \"2026-10-03\",\n  \"photoUrl\": \"https://example.com/wallet.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{apiBase}}/lost-items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('lostItemId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "recover lost item",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{apiBase}}/lost-items/{{lostItemId}}/recover"
          }
        }
      ]
    },
